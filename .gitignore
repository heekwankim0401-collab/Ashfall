# Unity crash / build artifacts
sysinfo.txt
*.apk
*.aab
*.unitypackage
*.app
crashlytics-build.properties
/[Aa]ssets/[Ss]treamingAssets/aa.meta
/[Aa]ssets/[Ss]treamingAssets/aa/*

# Local build helper output
*.result.txt

# Unity batchmode test output
/results.xml
/test.log
/setup.log

# vmux agent worktrees
.vmux/

# OS
.DS_Store
Thumbs.db
