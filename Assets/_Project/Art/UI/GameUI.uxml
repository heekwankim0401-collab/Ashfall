<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
    <!-- 게임 중 UI 하나 (설계 §5.4). GameUIRoot가 이름으로 요소를 찾는다. 이름을 바꾸면 C# 상수도 바꾼다. -->
    <Style src="Ashfall.uss" />
    <ui:VisualElement name="game-ui" class="ash-root" picking-mode="Ignore">

        <!-- §12 HUD (2026-10-28 상시 HUD B안, RULE-02·04·05 개정): 상시 — 체력·상태·막대(왼쪽 아래), 자세·무게·무기(오른쪽 아래), 퀵슬롯(아래 가운데), 남은 시간(위 가운데).
             일시 — F 프롬프트, RULE-04 탄창 확인 문구, M4 탈출 카운트다운, 피격 방향 가장자리. 크로스헤어·나침반·미니맵 없음(RULE-06·07). 그리기: HudView·HudStatusView. -->
        <ui:VisualElement name="hud" class="hud" picking-mode="Ignore">
            <ui:VisualElement name="hud-edge-top" class="hud-edge hud-edge-top" picking-mode="Ignore" />
            <ui:VisualElement name="hud-edge-right" class="hud-edge hud-edge-right" picking-mode="Ignore" />
            <ui:VisualElement name="hud-edge-bottom" class="hud-edge hud-edge-bottom" picking-mode="Ignore" />
            <ui:VisualElement name="hud-edge-left" class="hud-edge hud-edge-left" picking-mode="Ignore" />
            <ui:Label name="hud-time" class="hud-time" picking-mode="Ignore" />
            <ui:VisualElement name="hud-left" class="hud-left" picking-mode="Ignore">
                <ui:VisualElement name="hud-radiation" class="hud-bar-row" picking-mode="Ignore">
                    <ui:Label name="hud-radiation-text" class="hud-bar-label hud-radiation-text" picking-mode="Ignore" />
                    <ui:VisualElement class="hud-bar" picking-mode="Ignore">
                        <ui:VisualElement name="hud-radiation-fill" class="hud-bar-fill hud-bar-fill--radiation" picking-mode="Ignore" />
                    </ui:VisualElement>
                </ui:VisualElement>
                <ui:VisualElement class="hud-bar-row" picking-mode="Ignore">
                    <ui:Label text="스태미나" class="hud-bar-label" picking-mode="Ignore" />
                    <ui:VisualElement name="hud-stamina-bar" class="hud-bar" picking-mode="Ignore">
                        <ui:VisualElement name="hud-stamina-fill" class="hud-bar-fill hud-bar-fill--stamina" picking-mode="Ignore" />
                    </ui:VisualElement>
                </ui:VisualElement>
                <ui:VisualElement class="hud-bar-row" picking-mode="Ignore">
                    <ui:Label text="수분" class="hud-bar-label" picking-mode="Ignore" />
                    <ui:VisualElement name="hud-hydration-bar" class="hud-bar" picking-mode="Ignore">
                        <ui:VisualElement name="hud-hydration-fill" class="hud-bar-fill hud-bar-fill--hydration" picking-mode="Ignore" />
                    </ui:VisualElement>
                </ui:VisualElement>
                <ui:VisualElement class="hud-bar-row" picking-mode="Ignore">
                    <ui:Label text="에너지" class="hud-bar-label" picking-mode="Ignore" />
                    <ui:VisualElement name="hud-energy-bar" class="hud-bar" picking-mode="Ignore">
                        <ui:VisualElement name="hud-energy-fill" class="hud-bar-fill hud-bar-fill--energy" picking-mode="Ignore" />
                    </ui:VisualElement>
                </ui:VisualElement>
                <ui:VisualElement name="hud-parts" class="hud-parts" picking-mode="Ignore">
                    <ui:VisualElement class="hud-part-row" picking-mode="Ignore">
                        <ui:Label name="hud-part-0" class="hud-part" picking-mode="Ignore" />
                        <ui:Label name="hud-part-status-0" class="hud-part-status" picking-mode="Ignore" />
                    </ui:VisualElement>
                    <ui:VisualElement class="hud-part-row" picking-mode="Ignore">
                        <ui:Label name="hud-part-1" class="hud-part" picking-mode="Ignore" />
                        <ui:Label name="hud-part-status-1" class="hud-part-status" picking-mode="Ignore" />
                    </ui:VisualElement>
                    <ui:VisualElement class="hud-part-row" picking-mode="Ignore">
                        <ui:Label name="hud-part-2" class="hud-part" picking-mode="Ignore" />
                        <ui:Label name="hud-part-status-2" class="hud-part-status" picking-mode="Ignore" />
                    </ui:VisualElement>
                    <ui:VisualElement class="hud-part-row" picking-mode="Ignore">
                        <ui:Label name="hud-part-3" class="hud-part" picking-mode="Ignore" />
                        <ui:Label name="hud-part-status-3" class="hud-part-status" picking-mode="Ignore" />
                    </ui:VisualElement>
                    <ui:VisualElement class="hud-part-row" picking-mode="Ignore">
                        <ui:Label name="hud-part-4" class="hud-part" picking-mode="Ignore" />
                        <ui:Label name="hud-part-status-4" class="hud-part-status" picking-mode="Ignore" />
                    </ui:VisualElement>
                    <ui:VisualElement class="hud-part-row" picking-mode="Ignore">
                        <ui:Label name="hud-part-5" class="hud-part" picking-mode="Ignore" />
                        <ui:Label name="hud-part-status-5" class="hud-part-status" picking-mode="Ignore" />
                    </ui:VisualElement>
                    <ui:VisualElement class="hud-part-row" picking-mode="Ignore">
                        <ui:Label name="hud-part-6" class="hud-part" picking-mode="Ignore" />
                        <ui:Label name="hud-part-status-6" class="hud-part-status" picking-mode="Ignore" />
                    </ui:VisualElement>
                </ui:VisualElement>
                <ui:Label name="hud-body-effects" class="hud-body-effects" picking-mode="Ignore" />
            </ui:VisualElement>
            <ui:VisualElement name="hud-right" class="hud-right" picking-mode="Ignore">
                <ui:VisualElement class="hud-stance-row" picking-mode="Ignore">
                    <ui:Label name="hud-posture" class="hud-posture" picking-mode="Ignore" />
                    <ui:Label name="hud-weight" class="hud-weight" picking-mode="Ignore" />
                </ui:VisualElement>
                <ui:VisualElement name="hud-weapon" class="hud-weapon" picking-mode="Ignore">
                    <ui:Label name="hud-weapon-name" class="hud-weapon-name" picking-mode="Ignore" />
                    <ui:VisualElement class="hud-ammo-row" picking-mode="Ignore">
                        <ui:Label name="hud-ammo" class="hud-ammo" picking-mode="Ignore" />
                        <ui:Label name="hud-spare" class="hud-spare" picking-mode="Ignore" />
                    </ui:VisualElement>
                    <ui:Label name="hud-condition" class="hud-condition" picking-mode="Ignore" />
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:VisualElement name="hud-quickslots" class="hud-quickslots" picking-mode="Ignore">
                <ui:Label name="hud-quick-0" class="hud-quick" picking-mode="Ignore" />
                <ui:Label name="hud-quick-1" class="hud-quick" picking-mode="Ignore" />
                <ui:Label name="hud-quick-2" class="hud-quick" picking-mode="Ignore" />
                <ui:Label name="hud-quick-3" class="hud-quick" picking-mode="Ignore" />
            </ui:VisualElement>
            <ui:Label name="hud-prompt" class="hud-prompt" picking-mode="Ignore" />
            <ui:Label name="hud-toast" class="hud-toast" picking-mode="Ignore" />
            <ui:Label name="hud-extract" class="hud-extract" picking-mode="Ignore" />
        </ui:VisualElement>

        <!-- SYS-INV 인벤토리 (Tab). 패널 밖 어두운 곳에 놓으면 바닥에 버린다. -->
        <ui:VisualElement name="inventory-screen" class="screen inventory-screen">
            <ui:VisualElement name="inv-layout" class="inv-layout" picking-mode="Ignore">
                <ui:VisualElement name="inv-equip-panel" class="panel inv-panel inv-equip-panel">
                    <ui:Label text="장비" class="panel-title" picking-mode="Ignore" />
                    <ui:VisualElement name="inv-equip-slots" class="inv-equip-slots" picking-mode="Ignore" />
                </ui:VisualElement>
                <ui:VisualElement name="inv-storage-panel" class="panel inv-panel inv-storage-panel">
                    <ui:Label text="소지품" class="panel-title" picking-mode="Ignore" />
                    <ui:VisualElement name="inv-storage-grids" class="inv-storage-grids" picking-mode="Ignore" />
                    <ui:Label text="퀵슬롯" class="inv-section-title" picking-mode="Ignore" />
                    <ui:VisualElement name="inv-quick-slots" class="inv-quick-slots" picking-mode="Ignore" />
                </ui:VisualElement>
                <ui:VisualElement name="inv-loot-panel" class="panel inv-panel inv-loot-panel">
                    <ui:Label name="inv-loot-title" class="panel-title" picking-mode="Ignore" />
                    <ui:Label name="inv-loot-status" class="loot-status" picking-mode="Ignore" />
                    <ui:VisualElement name="inv-loot-grid-host" class="inv-loot-grid-host" picking-mode="Ignore" />
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:VisualElement name="inv-drag-layer" class="drag-layer" picking-mode="Ignore" />
        </ui:VisualElement>

        <!-- RULE-05 부위 상태 (H). 수치 없음. 7부위 목록 아래 M7 "전신" 한 줄(수분·에너지·방사능 등급 문구, Q43). -->
        <ui:VisualElement name="body-status-screen" class="screen body-status-screen">
            <ui:VisualElement class="panel bs-panel">
                <ui:Label text="부위 상태" class="panel-title" picking-mode="Ignore" />
                <ui:VisualElement name="body-status-list" class="bs-list" picking-mode="Ignore" />
                <ui:VisualElement name="body-status-survival" class="bs-survival" picking-mode="Ignore" />
            </ui:VisualElement>
        </ui:VisualElement>

        <!-- RULE-06 종이 지도 (M). POI·활성 탈출구·남은 시간 대략치. 내 위치 표식 없음. -->
        <ui:VisualElement name="map-screen" class="screen map-screen">
            <ui:VisualElement class="panel map-panel" picking-mode="Ignore">
                <ui:Label text="지도" class="panel-title" picking-mode="Ignore" />
                <ui:VisualElement name="map-area" class="map-area" picking-mode="Ignore" />
                <ui:Label name="map-time" class="map-time" picking-mode="Ignore" />
            </ui:VisualElement>
        </ui:VisualElement>

        <!-- Esc 일시정지 (세계 정지). [계속] / [레이드 포기] → 확인. 개발 빌드에서만 [귀환(개발)]을 코드가 pause-main 끝에 붙인다 (DEV-RETURN). -->
        <ui:VisualElement name="pause-screen" class="screen pause-screen">
            <ui:VisualElement class="panel pause-panel">
                <ui:Label text="일시정지" class="panel-title" picking-mode="Ignore" />
                <ui:VisualElement name="pause-main" class="pause-buttons">
                    <ui:Button name="pause-resume" text="계속" class="ash-button" />
                    <ui:Button name="pause-abandon" text="레이드 포기" class="ash-button ash-button--danger" />
                </ui:VisualElement>
                <ui:VisualElement name="pause-confirm" class="pause-buttons">
                    <ui:Label name="pause-confirm-text" text="레이드를 포기하면 가져온 장비를 모두 잃는다." class="pause-warning" picking-mode="Ignore" />
                    <ui:Button name="pause-confirm-yes" text="포기" class="ash-button ash-button--danger" />
                    <ui:Button name="pause-confirm-no" text="취소" class="ash-button" />
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>

        <!-- 레이드 종료 오버레이 (닫히지 않음, 몇 초 뒤 MainMenu로) -->
        <ui:VisualElement name="raid-end-screen" class="screen raid-end-screen" picking-mode="Ignore">
            <ui:Label name="raid-end-text" class="raid-end-text" picking-mode="Ignore" />
        </ui:VisualElement>

    </ui:VisualElement>
</ui:UXML>
