<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
    <!-- 메인 메뉴 (M4 설계 §1.3, M5 설계 §3.4·§4.5). MainMenuRoot가 이름으로 요소를 찾는다. 이름을 바꾸면 C# 상수도 바꾼다.
         문구는 UiText가 원본이고 여기 text는 미리보기용. M5 Q21: 레이드 결과 패널은 은신처(HideoutUI.uxml)로 옮겼다. -->
    <Style src="Ashfall.uss" />
    <ui:VisualElement name="main-menu" class="ash-root menu-root">

        <!-- [은신처] / [종료] (TODO(GDD-?) Q20). 버튼 이름 menu-start는 M4 씬·테스트 호환으로 유지. -->
        <ui:VisualElement name="menu-panel" class="panel menu-panel">
            <ui:Label name="menu-title" text="ASHFALL" class="menu-title" picking-mode="Ignore" />
            <ui:Button name="menu-start" text="은신처" class="ash-button" />
            <ui:Button name="menu-quit" text="종료" class="ash-button" />
        </ui:VisualElement>

    </ui:VisualElement>
</ui:UXML>
