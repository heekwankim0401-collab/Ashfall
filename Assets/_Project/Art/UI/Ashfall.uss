/* Ashfall 게임 UI 스타일 (설계 §5.4, GDD §10.1, §12).
   색은 §10.1 팔레트 토큰만 쓴다. 텍스트는 Bone. 새 색이 필요하면 팔레트에서 고른다.
   C#은 요소 이름·클래스만 알고 크기·색은 여기서 정한다(칸 크기 = --ash-cell-size). */

:root, .ash-root {
    /* §10.1 팔레트 */
    --ash-black: #0D0807;
    --dried-blood: #3A0B0B;
    --rust-red: #6E1A14;
    --ember: #B2321C;
    --ash-grey: #5A524E;
    --bone: #C9BBA8;
    --toxic: #7A8A2A;
    /* Ash_Black 반투명 (전체 화면 배경) */
    --ash-black-dim: rgba(13, 8, 7, 0.88);

    /* 배치 (TODO(GDD-?): 문서에 없음, 그레이박스 값) */
    --ash-cell-size: 48px;
    --ash-slot-width: 168px;
    --ash-slot-height: 52px;
    --ash-quick-width: 84px;
    --ash-map-size: 560px;
    /* M5 은신처 보관함 스크롤 폭 = 10칸 × --ash-cell-size(48px) + 세로 스크롤바 여유. 칸 크기를 바꾸면 같이 바꾼다. */
    --hideout-stash-width: 500px;
    --hideout-trader-column-width: 360px;
}

.ash-root {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    color: var(--bone);
    font-size: 14px;
}

.ash-root Label {
    color: var(--bone);
}

/* ── HUD: 일시 표시만 ─────────────────────────────── */

.hud {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
}

.hud-prompt {
    position: absolute;
    left: 0;
    right: 0;
    top: 58%;
    font-size: 16px;
    -unity-text-align: middle-center;
    -unity-text-outline-width: 1px;
    -unity-text-outline-color: var(--ash-black);
}

.hud-toast {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 12%;
    font-size: 18px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    -unity-text-outline-width: 1px;
    -unity-text-outline-color: var(--ash-black);
}

/* ── 전체 화면 공통 ───────────────────────────────── */

.screen {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    background-color: var(--ash-black-dim);
    align-items: center;
    justify-content: center;
}

.panel {
    background-color: var(--ash-black);
    border-width: 1px;
    border-color: var(--ash-grey);
    padding: 12px;
    margin: 0 8px;
}

.panel-title {
    font-size: 16px;
    -unity-font-style: bold;
    margin: 0 0 8px 0;
    padding: 0;
}

/* ── 인벤토리 ─────────────────────────────────────── */

.inv-layout {
    flex-direction: row;
    align-items: flex-start;
}

.inv-equip-slots {
    flex-direction: column;
}

.inv-slot {
    width: var(--ash-slot-width);
    height: var(--ash-slot-height);
    margin-bottom: 6px;
    padding: 2px 4px;
    border-width: 1px;
    border-color: var(--ash-grey);
    background-color: var(--ash-black);
}

.inv-slot.drop-ok {
    border-color: var(--bone);
}

.inv-slot.drop-bad {
    border-color: var(--ember);
}

.inv-slot-label {
    font-size: 11px;
    opacity: 0.6;
    margin: 0;
    padding: 0;
}

.inv-item--slot {
    flex-grow: 1;
}

.inv-storage-grids {
    flex-direction: column;
}

.inv-section {
    margin-bottom: 10px;
}

.inv-section-title {
    font-size: 12px;
    margin: 0 0 4px 0;
    padding: 0;
}

.inv-pocket-row {
    flex-direction: row;
}

.inv-pocket-row > .inv-grid {
    margin-right: 6px;
}

/* 그리드 폭 = 칸 수 × 칸 크기. 테두리·여백을 두지 않는다(뷰가 폭으로 칸 크기를 다시 잰다). */
.inv-grid {
    align-self: flex-start;
    flex-shrink: 0;
    flex-direction: column;
    border-width: 0;
    padding: 0;
    margin: 0;
}

.inv-grid-row {
    flex-direction: row;
    flex-shrink: 0;
}

.inv-cell {
    width: var(--ash-cell-size);
    height: var(--ash-cell-size);
    flex-shrink: 0;
    border-width: 1px;
    border-color: var(--ash-grey);
    background-color: var(--ash-black);
}

.inv-grid-items {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    overflow: hidden;
}

.inv-item {
    margin: 0;
    padding: 2px;
    border-width: 1px;
    border-color: var(--rust-red);
    background-color: var(--dried-blood);
    font-size: 11px;
    white-space: normal;
    overflow: hidden;
    -unity-text-align: middle-center;
}

/* 검색 전 루트 아이템 "?" */
.inv-item--hidden {
    border-color: var(--ash-grey);
    background-color: var(--ash-grey);
    font-size: 16px;
    -unity-font-style: bold;
}

.inv-item--drag-source {
    opacity: 0.3;
}

.inv-ghost {
    opacity: 0.85;
    border-color: var(--bone);
}

/* 패널 밖 = 바닥에 버리기 */
.inv-ghost--outside {
    border-color: var(--ember);
}

.inv-drop-highlight {
    opacity: 0.35;
}

.inv-drop-highlight.drop-ok {
    background-color: var(--bone);
}

.inv-drop-highlight.drop-bad {
    background-color: var(--ember);
}

.drag-layer {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
}

.inv-quick-slots {
    flex-direction: row;
}

.inv-quick {
    width: var(--ash-quick-width);
    height: var(--ash-cell-size);
    margin-right: 6px;
    padding: 0 4px;
    flex-direction: row;
    align-items: center;
    border-width: 1px;
    border-color: var(--ash-grey);
    background-color: var(--ash-black);
}

.inv-quick-key {
    font-size: 14px;
    -unity-font-style: bold;
    margin: 0 6px 0 0;
    padding: 0;
}

.inv-quick-item {
    font-size: 11px;
    flex-shrink: 1;
    white-space: normal;
    margin: 0;
    padding: 0;
}

.inv-loot-panel {
    min-width: 120px;
}

.loot-status {
    font-size: 12px;
    -unity-font-style: italic;
    margin: 0 0 6px 0;
    padding: 0;
}

/* ── 부위 상태 (RULE-05) ──────────────────────────── */

.bs-panel {
    min-width: 360px;
}

.bs-row {
    flex-direction: row;
    align-items: center;
    height: 32px;
    border-bottom-width: 1px;
    border-color: var(--ash-grey);
}

.bs-part {
    width: 90px;
}

.bs-tier {
    width: 64px;
    margin-right: 10px;
    padding: 2px 0;
    border-width: 1px;
    border-color: var(--ash-grey);
    -unity-text-align: middle-center;
}

.tier-healthy {
    border-color: var(--bone);
    background-color: var(--ash-black);
}

.tier-injured {
    background-color: var(--dried-blood);
}

.tier-critical {
    background-color: var(--rust-red);
}

.tier-destroyed {
    background-color: var(--ember);
    -unity-font-style: bold;
}

.bs-statuses {
    flex-direction: row;
}

.bs-status {
    margin: 0 4px 0 0;
    padding: 1px 6px;
    background-color: var(--rust-red);
    font-size: 12px;
}

/* ── M4: 탈출 카운트다운 (§12 허용 HUD, 구역 안에서만) ── */

.hud-extract {
    position: absolute;
    left: 0;
    right: 0;
    top: 28%;
    font-size: 20px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    -unity-text-outline-width: 1px;
    -unity-text-outline-color: var(--ash-black);
}

/* ── M4: 버튼 (일시정지·메인 메뉴·결과) ───────────── */

.ash-button {
    min-width: 200px;
    height: 36px;
    margin: 4px 0;
    padding: 0 12px;
    border-width: 1px;
    border-radius: 0;
    border-color: var(--ash-grey);
    background-color: var(--ash-black);
    color: var(--bone);
    font-size: 15px;
    -unity-text-align: middle-center;
}

.ash-button:hover {
    border-color: var(--bone);
    background-color: var(--dried-blood);
}

.ash-button:active {
    background-color: var(--rust-red);
}

.ash-button:disabled {
    opacity: 0.4;
}

.ash-button--danger {
    border-color: var(--ember);
}

/* ── M4: 일시정지 ─────────────────────────────────── */

.pause-panel {
    min-width: 280px;
    align-items: stretch;
}

.pause-buttons {
    flex-direction: column;
    align-items: stretch;
}

.ash-root .pause-warning {
    max-width: 320px;
    margin: 0 0 8px 0;
    white-space: normal;
    color: var(--ember);
}

/* ── M4: 지도 (RULE-06, 내 위치 없음) ─────────────── */

.map-area {
    /* TODO(GDD-?) Q11: 그레이박스. 지도 영역(1km)을 정사각형으로 그린다. 지형 그림은 M6. */
    width: var(--ash-map-size);
    height: var(--ash-map-size);
    border-width: 1px;
    border-color: var(--ash-grey);
    background-color: var(--dried-blood);
    overflow: hidden;
}

.map-marker {
    position: absolute;
    flex-direction: row;
    align-items: center;
    /* 점(8px) 중심이 좌표에 오게 */
    margin-left: -4px;
    margin-top: -6px;
}

.map-marker-dot {
    width: 8px;
    height: 8px;
    border-radius: 4px;
    background-color: var(--ash-grey);
}

.map-marker-label {
    margin: 0 0 0 4px;
    padding: 0;
    font-size: 12px;
    -unity-text-outline-width: 1px;
    -unity-text-outline-color: var(--ash-black);
}

.map-marker--extract > .map-marker-dot {
    width: 10px;
    height: 10px;
    border-radius: 0;
    background-color: var(--ember);
}

.map-marker--extract > .map-marker-label {
    -unity-font-style: bold;
}

.map-time {
    margin: 8px 0 0 0;
    padding: 0;
    font-size: 14px;
}

/* ── M4: 레이드 종료 오버레이 ─────────────────────── */

.raid-end-text {
    font-size: 36px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

/* ── M4: 메인 메뉴·레이드 결과 (MainMenu.uxml) ───── */

.menu-root {
    background-color: var(--ash-black);
    align-items: center;
    justify-content: center;
}

.menu-panel {
    align-items: stretch;
    padding: 24px;
}

.menu-title {
    font-size: 44px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    letter-spacing: 6px;
    margin: 0 0 16px 0;
}

.result-panel {
    min-width: 560px;
    max-height: 90%;
    padding: 20px;
}

.result-title {
    font-size: 26px;
    -unity-font-style: bold;
    margin: 0 0 8px 0;
}

.ash-root .result--survived {
    color: var(--bone);
}

.ash-root .result--died {
    color: var(--ember);
}

.result-stats {
    flex-direction: row;
    margin-bottom: 12px;
}

.result-stat {
    margin: 0 24px 0 0;
    padding: 0;
}

.result-lists {
    flex-direction: row;
    align-items: flex-start;
    margin-bottom: 12px;
}

.result-section {
    width: 220px;
    margin-right: 12px;
}

.result-list {
    flex-direction: column;
}

.result-line {
    font-size: 13px;
    margin: 0;
    padding: 1px 0;
    white-space: normal;
}

.result-line--empty {
    opacity: 0.5;
}

/* ── M5: 은신처 (HideoutUI.uxml, M5 설계 §3.4) ───── */

.hideout-root {
    background-color: var(--ash-black);
    align-items: center;
    justify-content: center;
}

.hideout-hub {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    flex-direction: column;
    padding: 16px 24px;
}

.hideout-header {
    flex-direction: row;
    align-items: center;
    flex-shrink: 0;
    padding-bottom: 8px;
    border-bottom-width: 1px;
    border-color: var(--ash-grey);
}

.hideout-title {
    font-size: 26px;
    -unity-font-style: bold;
    letter-spacing: 4px;
    margin: 0 24px 0 0;
}

.hideout-casings {
    font-size: 18px;
    -unity-font-style: bold;
    min-width: 140px;
    margin: 0 24px 0 0;
}

.hideout-tabs {
    flex-direction: row;
    margin-right: 24px;
}

.ash-button.hideout-tab {
    min-width: 96px;
    margin: 0 6px 0 0;
}

.ash-button.hideout-tab--selected {
    border-color: var(--bone);
    background-color: var(--rust-red);
}

.hideout-kit {
    flex-direction: row;
    align-items: center;
}

.hideout-kit-status {
    margin: 0 0 0 8px;
    min-width: 100px;
}

.hideout-spacer {
    flex-grow: 1;
}

.ash-button.hideout-action {
    min-width: 140px;
    margin: 0 0 0 8px;
}

.ash-root .hideout-message {
    height: 24px;
    flex-shrink: 0;
    margin: 6px 0;
    padding: 0;
    color: var(--bone);
    -unity-font-style: italic;
}

.hideout-content {
    flex-grow: 1;
    flex-shrink: 1;
    flex-direction: column;
    overflow: hidden;
}

/* [장비] 탭: 레이드 인벤토리와 같은 요소, 전체 화면 대신 허브 안에 채운다 */
.hideout-inventory {
    flex-grow: 1;
    flex-shrink: 1;
}

.hideout-inv-layout {
    flex-grow: 1;
    flex-shrink: 1;
    align-items: stretch;
}

.hideout-storage-panel,
.hideout-stash-panel {
    flex-shrink: 1;
}

.hideout-scroll {
    flex-grow: 1;
    flex-shrink: 1;
}

.hideout-stash-scroll {
    width: var(--hideout-stash-width);
}

/* [상인] 탭 */
.trader-panel {
    flex-grow: 1;
    flex-shrink: 1;
    margin: 0;
}

.trader-columns {
    flex-direction: row;
    flex-grow: 1;
    flex-shrink: 1;
}

.trader-column {
    width: var(--hideout-trader-column-width);
    margin-right: 24px;
    flex-shrink: 1;
}

.trader-list {
    flex-direction: column;
}

.trader-row {
    flex-direction: row;
    align-items: center;
    height: 36px;
    border-bottom-width: 1px;
    border-color: var(--ash-grey);
}

.trader-row-name {
    flex-grow: 1;
    margin: 0;
    padding: 0;
}

.trader-row-price {
    width: 90px;
    margin: 0 8px 0 0;
    padding: 0;
    -unity-text-align: middle-right;
}

.ash-button.trader-row-button {
    min-width: 72px;
    height: 28px;
    margin: 0;
}

/* 알림 패널 */
.hideout-notice-panel {
    min-width: 560px;
    max-width: 720px;
    max-height: 90%;
    padding: 20px;
}

.hideout-notice-text {
    white-space: normal;
    margin: 0 0 12px 0;
}

.hideout-notice-section {
    width: auto;
    margin-bottom: 12px;
}
